#!/usr/bin/env node

/**
 * GLM Code - 独立的 GLM-5.1 coding agent
 * 
 * 基于 Pi harness，但作为独立应用运行
 */

const { execSync, spawn } = require('child_process');
const path = require('path');
const fs = require('fs');

// 获取 glm-tui 项目根目录
const GLM_CODE_ROOT = path.resolve(__dirname, '..');

// 默认配置
const DEFAULT_CONFIG = {
  provider: 'anthropic',
  model: 'claude-sonnet-4-20250514',
  
  glm: {
    apiKey: process.env.GLM_API_KEY || '',
    model: process.env.GLM_MODEL || 'glm-5.1',
    endpoint: process.env.GLM_ENDPOINT || 'https://api.z.ai/api/coding/paas/v4',
  },
  
  features: {
    planningMode: true,
    selfCorrection: true,
  },
};

/**
 * 加载配置
 */
function loadConfig() {
  let config = { ...DEFAULT_CONFIG };
  
  // 加载项目级配置
  const projectConfigPath = path.join(process.cwd(), '.glm-code.json');
  if (fs.existsSync(projectConfigPath)) {
    try {
      const projectConfig = JSON.parse(fs.readFileSync(projectConfigPath, 'utf-8'));
      config = { ...config, ...projectConfig };
    } catch (err) {
      console.warn('Warning: Could not load project config:', err.message);
    }
  }
  
  // 加载用户级配置
  const homeDir = process.env.HOME || process.env.USERPROFILE || '';
  const userConfigPath = path.join(homeDir, '.glm-code.json');
  if (fs.existsSync(userConfigPath)) {
    try {
      const userConfig = JSON.parse(fs.readFileSync(userConfigPath, 'utf-8'));
      config = { ...config, ...userConfig };
    } catch (err) {
      console.warn('Warning: Could not load user config:', err.message);
    }
  }
  
  // 应用环境变量
  if (process.env.GLM_API_KEY) {
    config.glm.apiKey = process.env.GLM_API_KEY;
  }
  if (process.env.GLM_MODEL) {
    config.glm.model = process.env.GLM_MODEL;
  }
  if (process.env.GLM_ENDPOINT) {
    config.glm.endpoint = process.env.GLM_ENDPOINT;
  }
  
  return config;
}

/**
 * 构建系统提示词
 */
function buildSystemPrompt(config) {
  const parts = [];
  
  // 核心系统提示词
  const systemPromptPath = path.join(GLM_CODE_ROOT, 'prompts', 'system.md');
  if (fs.existsSync(systemPromptPath)) {
    parts.push(fs.readFileSync(systemPromptPath, 'utf-8'));
  }
  
  // 规划模式提示词
  if (config.features.planningMode) {
    const planningPromptPath = path.join(GLM_CODE_ROOT, 'prompts', 'planning.md');
    if (fs.existsSync(planningPromptPath)) {
      parts.push(fs.readFileSync(planningPromptPath, 'utf-8'));
    }
  }
  
  // 自我纠错提示词
  if (config.features.selfCorrection) {
    const correctionPromptPath = path.join(GLM_CODE_ROOT, 'prompts', 'correction.md');
    if (fs.existsSync(correctionPromptPath)) {
      parts.push(fs.readFileSync(correctionPromptPath, 'utf-8'));
    }
  }
  
  return parts.join('\n\n---\n\n');
}

/**
 * 查找 Pi 可执行文件
 */
function findPiBinary() {
  // 1. 检查本地 node_modules
  const localPi = path.join(GLM_CODE_ROOT, 'node_modules', '.bin', 'pi');
  if (fs.existsSync(localPi)) {
    return localPi;
  }
  
  // 2. 检查全局安装
  try {
    const globalBin = execSync('which pi', { encoding: 'utf-8' }).trim();
    if (globalBin) {
      return globalBin;
    }
  } catch (err) {
    // ignore
  }
  
  return null;
}

/**
 * 启动 Pi
 */
function launchPi(config, args) {
  const systemPrompt = buildSystemPrompt(config);
  
  // 构建 Pi 命令参数
  const piArgs = [
    // 模型配置
    '--provider', config.provider,
    '--model', config.model,
    
    // 系统提示词
    '--system-prompt', systemPrompt,
    
    // 其他配置
    ...args,
  ];
  
  // 查找 Pi 可执行文件
  const piBin = findPiBinary();
  
  if (!piBin) {
    console.error('Error: Could not find pi binary. Please install @earendil-works/pi-coding-agent');
    console.error('Run: npm install -g @earendil-works/pi-coding-agent');
    process.exit(1);
  }
  
  // 启动 Pi
  const child = spawn(piBin, piArgs, {
    stdio: 'inherit',
    cwd: process.cwd(),
    env: {
      ...process.env,
      // 设置 GLM Code 环境变量
      GLM_CODE_ROOT,
      GLM_CODE_VERSION: require('../package.json').version,
    },
  });
  
  child.on('error', (err) => {
    console.error('Failed to start pi:', err.message);
    process.exit(1);
  });
  
  child.on('exit', (code) => {
    process.exit(code || 0);
  });
}

/**
 * 显示帮助信息
 */
function showHelp() {
  console.log(`
GLM Code - 独立的 GLM-5.1 coding agent

Usage: glm [options] [messages...]

Options:
  -h, --help          显示帮助信息
  -v, --version       显示版本信息
  -p, --print         非交互模式，打印响应后退出
  -c, --continue      继续最近的会话
  -r, --resume        浏览并选择历史会话
  --planning          启用规划模式（默认启用）
  --no-planning       禁用规划模式
  --correction        启用自我纠错（默认启用）
  --no-correction     禁用自我纠错
  --provider <name>   模型提供者
  --model <name>      模型名称
  
  所有其他参数将传递给 Pi。

Examples:
  glm                           # 启动交互模式
  glm -p "创建一个 React 组件"    # 非交互模式
  glm --planning                # 启用规划模式
  glm -c                        # 继续最近的会话

Environment Variables:
  GLM_API_KEY         GLM API 密钥
  GLM_MODEL           默认模型
  GLM_ENDPOINT        GLM API 端点
`);
}

/**
 * 显示版本信息
 */
function showVersion() {
  const pkg = require('../package.json');
  console.log(`GLM Code v${pkg.version}`);
  console.log(`Pi harness: ${findPiBinary() || 'not found'}`);
}

// 主入口
function main() {
  const args = process.argv.slice(2);
  
  // 处理帮助和版本
  if (args.includes('-h') || args.includes('--help')) {
    showHelp();
    process.exit(0);
  }
  
  if (args.includes('-v') || args.includes('--version')) {
    showVersion();
    process.exit(0);
  }
  
  // 加载配置
  const config = loadConfig();
  
  // 处理 GLM Code 特有参数
  const piArgs = [];
  let i = 0;
  
  while (i < args.length) {
    const arg = args[i];
    
    switch (arg) {
      case '--planning':
        config.features.planningMode = true;
        i++;
        break;
        
      case '--no-planning':
        config.features.planningMode = false;
        i++;
        break;
        
      case '--correction':
        config.features.selfCorrection = true;
        i++;
        break;
        
      case '--no-correction':
        config.features.selfCorrection = false;
        i++;
        break;
        
      case '--provider':
        if (i + 1 < args.length) {
          config.provider = args[i + 1];
          i += 2;
        } else {
          i++;
        }
        break;
        
      case '--model':
        if (i + 1 < args.length) {
          config.model = args[i + 1];
          i += 2;
        } else {
          i++;
        }
        break;
        
      default:
        // 其他参数传递给 Pi
        piArgs.push(arg);
        i++;
    }
  }
  
  // 启动 Pi
  launchPi(config, piArgs);
}

main();
