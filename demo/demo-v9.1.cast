[25.512423, "o", "\r\n"]
[25.512954, "o", "  \u001b[0;36m[FIX]\u001b[0m 1. Add ReentrancyGuard from OpenZeppelin\r\n  \u001b[0;36m[FIX]\u001b[0m 2. Apply Checks-Effects-Interactions pattern"]
[25.513283, "o", "\r\n  \u001b[0;36m[FIX]\u001b[0m 3. Update balance BEFORE external call\r\n\r\n"]
[25.513527, "o", "\u001b[2m  function withdraw() external nonReentrant {\r\n      uint256 bal = balances[msg.sender];"]
[25.513761, "o", "\r\n      require(bal > 0, \"no balance\");\r\n      balances[msg.sender] = 0;  // effect before interaction"]
[25.513929, "o", "\r\n      (bool ok, ) = msg.sender.call{value: bal}(\"\");"]
[25.514084, "o", "\r\n      require(ok, \"transfer failed\");"]
[25.514165, "o", "\r\n  }\u001b[0m"]
[25.515091, "o", "\r\n"]
