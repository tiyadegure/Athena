[12.665758, "o", "  \u001b[1;33m> athena rag --query \"reentrancy attack patterns\"\u001b[0m\r\n"]
[13.469016, "o", "\r\n  \u001b[0;32m[MATCH]\u001b[0m SWC-107: Reentrancy\r\n  \u001b[2m     ├── TheDAO hack (2016) — $60M drained\u001b[0m\r\n  \u001b[2m     ├── Curve V2 read-only reentrancy (2023) — $70M at risk\u001b[0m\r\n  \u001b[2m     └── Hundred Finance (2023) — $7M stolen\u001b[0m\r\n\r\n  \u001b[0;32m[MATCH]\u001b[0m Mitigation: Checks-Effects-Interactions pattern\r\n  \u001b[0;32m[MATCH]\u001b[0m OpenZeppelin ReentrancyGuard usage\r\n"]
