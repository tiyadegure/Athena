[0.016678, "o", "\r\n\u001b[1m  ╔══════════════════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[1m  ║\u001b[0m  \u001b[0;36mA T H E N A\u001b[0m — Web3 Smart Contract Security Audit Agent    \u001b[1m║\u001b[0m\r\n\u001b[1m  ║\u001b[0m  Powered by GLM-5.1 Long-Horizon Task                     \u001b[1m║\u001b[0m\r\n\u001b[1m  ╚══════════════════════════════════════════════════════════════╝\u001b[0m\r\n\r\n  \u001b[2mModel:\u001b[0m     GLM-5.1 (200K context, long-horizon reasoning)\r\n  \u001b[2mPipeline:\u001b[0m  8-step audit with subagent parallel orchestration\r\n  \u001b[2mTools:\u001b[0m     13 MCP tools (slither, aderyn, poc_generator, fuzz_runner...)\r\n  \u001b[2mChains:\u001b[0m    Sepolia + Base Sepolia\r\n\r\n"]
