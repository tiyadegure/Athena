[14.057776, "o", "\r\n  \u001b[0;31m[HIGH]\u001b[0m  reentrancy-eth: Reentrancy in VulnerableBank.withdraw()\r\n  \u001b[2m     External call before state update at line 25\u001b[0m\r\n  \u001b[2m[LOW]\u001b[0m  solc-version: Unspecific pragma version\r\n  \u001b[2m[INFO]\u001b[0m low-level-calls: Low-level call usage\r\n\r\n"]
